# Supabase — from Project Settings → API (or the newer "API Keys" page).
NEXT_PUBLIC_SUPABASE_URL=
# Use EITHER the legacy anon JWT key OR the new publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL — NOT required by RBMS. Guest checkout goes through the place_order()
# SECURITY DEFINER function (anon-callable) and the admin area uses authenticated
# staff sessions, so no service-role key is needed. Only set this if some future
# server task must deliberately bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (auth redirects, order-tracking links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
